# Output: only output_example.xml is tracked
output/*
!output/output_example.xml

# Input: nothing tracked
input/

# dont track models folder
models/
!/models/README.md
!/models/download_model.py

# Environment and secrets
.env
.env.local
*.pem
credentials.json
secrets/

# Dependencies (reinstallable)
node_modules/
venv/
.venv/
__pycache__/
*.pyc

# Build outputs
dist/
build/
*.egg-info/

# IDE/Editor files
.vscode/
.idea/
.cursor/
*.swp

# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json

# OS files
.DS_Store
Thumbs.db

# Logs and temp files
*.log
tmp/

# Runtime data (generated at startup)
data/
cache/
*.db