# Server
PORT=8000

# Paths
DB_PATH=data/knowledge.db
CACHE_DIR=cache
INPUT_DIR=input

# Background upload queue (immediate pipeline processing)
QUEUE_DRAIN_ENABLED=true
# Seconds to wait after first queued file before draining more (upload batch coalescing)
QUEUE_COALESCE_DEBOUNCE_SECONDS=0.2

# LLM (Phase 2) — OpenAI-compatible HTTP API (/v1/chat/completions, /v1/models)
# Default matches app/config.py: llama.cpp llama-server (typically port 8080).
# For Ollama instead, use http://localhost:11434 and an Ollama model tag.
LLAMA_SERVER_URL=http://localhost:8080
LLAMA_MODEL=gemma-4-e4b

# Whisper (Phase 2)
WHISPER_MODEL=small
# auto: CUDA if torch sees a GPU, else CPU. cuda/cpu: fixed. Missing libcublas (GPU libs) falls back to CPU once.
# pip install nvidia-cublas-cu12 (declared in requirements on Linux) so libcublas.so.12 is found.
WHISPER_DEVICE=auto
WHISPER_BATCH_SIZE=8
DENOISE_MAX_MB=100

# Qdrant (Phase 3)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge

# Tailscale — bind address for the uvicorn server
# Dev: 127.0.0.1 (localhost only)
# Production: set to your Tailscale IP (e.g. 100.x.x.x) so the server is
#   reachable from other Tailscale nodes without exposing a public port.
TAILSCALE_HOST=127.0.0.1
