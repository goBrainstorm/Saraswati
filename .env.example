# Server
HOST=127.0.0.1
PORT=8000

# Paths
DB_PATH=data/knowledge.db
CACHE_DIR=cache
INPUT_DIR=input

# Retention
LOCAL_RETENTION_DAYS=7

# Schedule (cron)
SCHEDULE_CRON=0 3 * * *

# Nextcloud (WebDAV)
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_PASS=
NEXTCLOUD_REMOTE_DIR=/Knowledge/Audio

# LLM (Phase 2)
LLAMA_SERVER_URL=http://localhost:8080
LLAMA_MODEL=gemma-4-e4b

# Whisper (Phase 2)
WHISPER_MODEL=large-v3
DENOISE_MAX_MB=100

# Qdrant (Phase 3)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge

# Tailscale (set to Tailscale IP for production, 127.0.0.1 for dev)
TAILSCALE_HOST=127.0.0.1
